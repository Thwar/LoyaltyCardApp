rules_version = '2';

// SoyCasero — the browser NEVER talks to Firestore.
//
// The client bundle imports only `firebase/app` + `firebase/auth` (see
// lib/firebaseClient.ts); every read and write goes through our /api routes using
// the Admin SDK (lib/firebaseAdmin.ts), which bypasses these rules entirely. So the
// only traffic these rules can possibly see is someone pointing the Firestore REST
// API at our project with a token they minted from the public web API key — signup
// is open and unverified, so that is anybody.
//
// Therefore: deny everything. This costs us nothing and closes the whole class of
// attack. The previous ruleset was a leftover from a client-SDK architecture and
// granted every signed-in user `read` (which includes `list`) over /businesses and
// /loyaltyCards — enumerable owner names, emails, phones, plans and broadcast
// history for every business — plus self-service `update` on their own business doc,
// which made the `plan` field (lib/plans.ts reads it directly) client-writable.
//
// If a future feature genuinely needs client-side Firestore, add a narrow match
// block for exactly that path — do not relax this default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

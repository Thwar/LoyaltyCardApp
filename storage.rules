rules_version = '2';

// SoyCasero — Cloud Storage is not used.
//
// Logos are resized client-side, posted through our /api routes and stored as
// base64 on the Firestore doc (LoyaltyCard.logoPng / Business.logoPng); nothing in
// the client bundle imports `firebase/storage`. The previous ruleset kept
// world-readable, owner-writable buckets for business-logos/, user-profiles/ and
// loyalty-card-backgrounds/ — paths no code writes to, but any signed-up account
// could still have used them as unmetered public file hosting.
//
// Deny everything. Re-open a specific prefix only if a feature actually needs it.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
